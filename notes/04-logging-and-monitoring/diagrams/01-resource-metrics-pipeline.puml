@startuml
!include ../../../tools/diagrams/cka-theme.puml
left to right direction

rectangle "Each node" <<group>> {
  rectangle "Containers\n<size:11>CPU · memory</size>" as ctr <<muted>>
  rectangle "kubelet + cAdvisor\n<size:11>/metrics/resource on :10250</size>" as kubelet <<plain>>
}
rectangle "metrics-server\n<size:11>Deployment in kube-system</size>\n<size:11>latest values only, in memory</size>" as ms <<accent>>
rectangle "kube-apiserver\n<size:11>APIService metrics.k8s.io</size>\n<size:11>(aggregation layer)</size>" as api <<plain>>
rectangle "Consumers\n<size:11>kubectl top · HPA · VPA</size>" as users <<good>>

ctr --> kubelet : cgroup stats
kubelet --> ms : scraped
ms --> api : registered as
api --> users
@enduml
