@startuml
!include ../../../tools/diagrams/cka-theme.puml
title Each tier talks to a stable Service name, never to a Pod

rectangle "front-end Pods" <<group>> as fe {
  rectangle "10.244.0.2" <<plain>> as f1
  rectangle "10.244.0.3" <<plain>> as f2
  rectangle "10.244.0.4" <<plain>> as f3
  f1 -[hidden]right-> f2
  f2 -[hidden]right-> f3
}

rectangle "Service  back-end  ·  ClusterIP 10.106.127.123:80" <<accent>> as sb

rectangle "back-end Pods" <<group>> as be {
  rectangle "10.244.0.5" <<plain>> as b1
  rectangle "10.244.0.6" <<plain>> as b2
  rectangle "10.244.0.7" <<plain>> as b3
  b1 -[hidden]right-> b2
  b2 -[hidden]right-> b3
}

rectangle "Service  redis  ·  ClusterIP 10.106.33.8:6379" <<accent>> as sr

rectangle "redis Pods" <<group>> as re {
  rectangle "10.244.0.8" <<plain>> as r1
  rectangle "10.244.0.9" <<plain>> as r2
  rectangle "10.244.0.10" <<plain>> as r3
  r1 -[hidden]right-> r2
  r2 -[hidden]right-> r3
}

fe -down-> sb : http://back-end
sb -down-> be : one Pod per connection, chosen at random
be -down-> sr : redis:6379
sr -down-> re

caption <i>Any tier can scale or have its Pods replaced without the tier above noticing. Nothing here is reachable from outside the cluster.</i>
@enduml
